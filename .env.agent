# Patient Matching Agent - Environment Configuration
# Source this before running the agent:
#   PowerShell: Get-Content .env.agent | ForEach-Object { if ($_ -match '^([^#=]+)=(.*)$') { [Environment]::SetEnvironmentVariable($matches[1], $matches[2]) } }
#   Bash: export $(grep -v '^#' .env.agent | xargs)

AZURE_AI_FOUNDRY_PROJECT_ENDPOINT=<your-foundry-project-endpoint>
AZURE_OPENAI_DEPLOYMENT=gpt-4o
PM_DB_TYPE=cosmos
COSMOS_GREMLIN_ENDPOINT=<your-cosmos-account>.gremlin.cosmos.azure.com
COSMOS_DATABASE=patient-matching-db
COSMOS_CONTAINER=patients
COSMOS_KEY=<your-cosmos-key>
